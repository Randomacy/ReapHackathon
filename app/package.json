{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "build:electron": "tsc -p tsconfig.electron.json",
    "electron:dev": "wait-on http://localhost:3000 && npm run build:electron && electron .",
    "overlay": "concurrently -k -n NEXT,ELECTRON \"npm run dev\" \"npm run electron:dev\""
  },
  "dependencies": {
    "framer-motion": "^14.0.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "electron": "^44.7.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "typescript": "^5",
    "wait-on": "^9.5.1"
  }
}
